---
import { streams } from '../../data/signal';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
---

<InteriorLayout title="Signal" description="Highly Curated Streams">
  {streams.map(({ id, title, description, feed, entries }) => (
    <section class="stream" id={id} aria-labelledby={id + '-title'}>
      <header class="section-head">
        <h2 id={id + '-title'}>{title}</h2>
        {feed && <a href={feed}>Subscribe (Atom)</a>}
      </header>
      <p class="section-description">{description}</p>
      {entries.map(({ title, summary, url, thumbnail }) => (
        <article class:list={['entry', { 'feed-row': thumbnail }]}>
          {thumbnail && <div class:list={['thumb', thumbnail]} aria-hidden="true"></div>}
          <div>
            <h3 class="entry-title">{url ? <a href={url}>{title}</a> : title}</h3>
            <p class="entry-summary">{summary}</p>
          </div>
        </article>
      ))}
    </section>
  ))}
</InteriorLayout>
