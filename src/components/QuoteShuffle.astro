---
const quotes = [
  { text: 'Our life is frittered away by detail.', author: 'Henry David Thoreau', source: 'https://www.gutenberg.org/ebooks/205' },
  { text: 'Nothing can bring you peace but yourself.', author: 'Ralph Waldo Emerson', source: 'https://www.gutenberg.org/ebooks/2944' },
  { text: 'A foolish consistency is the hobgoblin of little minds.', author: 'Ralph Waldo Emerson', source: 'https://www.gutenberg.org/ebooks/2944' },
  { text: 'Simplify, simplify.', author: 'Henry David Thoreau', source: 'https://www.gutenberg.org/ebooks/205' },
];
const [firstQuote] = quotes;
---

<section class="quotation" aria-label="Favorite quotes" data-quotes={JSON.stringify(quotes)}>
  <span class="quote-mark" aria-hidden="true">“</span>
  <figure aria-live="polite" aria-atomic="true">
    <blockquote>{firstQuote.text}</blockquote>
    <figcaption><a class="quote-author" href={firstQuote.source}>{firstQuote.author}</a></figcaption>
  </figure>
  <button class="shuffle" type="button" hidden>
    <svg class="icon" aria-hidden="true"><use href="#shuffle-icon" /></svg>
    Shuffle quote
  </button>
</section>

<script>
  interface Quote {
    text: string;
    author: string;
    source: string;
  }

  const section = document.querySelector<HTMLElement>('[data-quotes]');
  const button = section?.querySelector('button');
  const quote = section?.querySelector('blockquote');
  const author = section?.querySelector<HTMLAnchorElement>('.quote-author');

  if (section?.dataset.quotes && button && quote && author) {
    const quotes: Quote[] = JSON.parse(section.dataset.quotes);
    let current = 0;

    button.hidden = false;
    button.addEventListener('click', () => {
      const offset = 1 + Math.floor(Math.random() * (quotes.length - 1));
      current = (current + offset) % quotes.length;
      const next = quotes[current];

      quote.textContent = next.text;
      author.textContent = next.author;
      author.href = next.source;
    });
  }
</script>
