---
import { getEntry, type CollectionEntry } from 'astro:content';

type Quote = CollectionEntry<'quoteLists'>['data']['quotes'][number];
const quotes = (await getEntry('quoteLists', 'quotes'))?.data.quotes ?? [];
const [firstQuote] = quotes;
---

{firstQuote && <section class="quotation" aria-label="Favorite quotes" data-quotes={JSON.stringify(quotes)}>
  <span class="quote-mark" aria-hidden="true">“</span>
  <figure aria-live="polite" aria-atomic="true">
    <blockquote>{firstQuote.text}</blockquote>
    <figcaption hidden={!firstQuote.author}><span class="quote-author">{firstQuote.author}</span></figcaption>
  </figure>
  <button class="shuffle" type="button" aria-label="Shuffle quote" hidden>
    <span class="shuffle-chevron" aria-hidden="true"></span>
  </button>
</section>}

<script>
  import type { CollectionEntry } from 'astro:content';
  type Quote = CollectionEntry<'quoteLists'>['data']['quotes'][number];

  const section = document.querySelector<HTMLElement>('[data-quotes]');
  const button = section?.querySelector('button');
  const quote = section?.querySelector('blockquote');
  const caption = section?.querySelector('figcaption');
  const author = caption?.querySelector('.quote-author');

  if (section?.dataset.quotes && button && quote && caption && author) {
    const quotes: Quote[] = JSON.parse(section.dataset.quotes);
    let current = 0;

    button.hidden = quotes.length < 2;
    button.addEventListener('click', () => {
      const offset = 1 + Math.floor(Math.random() * (quotes.length - 1));
      current = (current + offset) % quotes.length;
      const next = quotes[current];

      quote.textContent = next.text;
      author.textContent = next.author ?? '';
      caption.hidden = !next.author;
    });
  }
</script>
